# Copy this file to .env and fill in what you use. It is gitignored and never
# leaves your machine. Leave a line out entirely if you do not need it.

# Gmail address and app password for the digest email.
# An app password is not your login password. Get one at:
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Same account, for reading LinkedIn and Indeed job-alert mail.
IMAP_USER=you@gmail.com
IMAP_PASSWORD=abcd efgh ijkl mnop

# Optional. A Discord or ntfy webhook for a push on your phone.
# WEBHOOK_URL=https://ntfy.sh/your-topic
